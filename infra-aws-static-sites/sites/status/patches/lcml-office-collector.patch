+def record_timeseries(cfg, snapshot, current_payload, now=None):
+    """Status 메뉴에서 필요한 공개 가능한 상태·메트릭 샘플만 31일 보존한다."""
+    settings = cfg.get("timeseries") or {}
+    path_text = settings.get("local_path")
+    if not path_text:
+        return None
+    path = Path(path_text).expanduser()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        history = json.loads(path.read_text(encoding="utf-8")) if path.exists() else {"schemaVersion": 1, "metrics": {}}
+    except (OSError, json.JSONDecodeError):
+        history = {"schemaVersion": 1, "metrics": {}}
+    history.setdefault("metrics", {})
+    now = now or now_utc()
+    timestamp = int(now.timestamp())
+    retention_days = int(settings.get("retention_days", 31))
+    cutoff = timestamp - retention_days * 86400
+    for metric_id, (query, unit) in PROMETHEUS_SERIES.items():
+        history["metrics"].setdefault(metric_id, {
+            "kind": "state" if metric_id == "system.node_health" else "numeric",
+            "unit": unit,
+            "source": "Prometheus",
+            "series": [],
+        })
+
+    def append(metric_id, series_name, value, kind="numeric", unit="", point_time=timestamp):
+        if value is not None:
+            try:
+                value = float(value)
+            except (TypeError, ValueError):
+                return
+        entry = history["metrics"].setdefault(metric_id, {"kind": kind, "unit": unit, "series": []})
+        entry["kind"], entry["unit"] = kind, unit
+        series = next((item for item in entry["series"] if item.get("name") == str(series_name)), None)
+        if series is None:
+            series = {"name": str(series_name), "points": []}
+            entry["series"].append(series)
+        if not series["points"] or series["points"][-1][0] != point_time:
+            series["points"].append([point_time, value])
+
+    # Prometheus can supply real historical samples immediately; only the
+    # system/agent state series begin at the first safe collector snapshot.
+    if not history.get("prometheusBackfillComplete"):
+        prom_base = ((cfg.get("monitoring") or {}).get("prometheus_service") or "")
+        range_url = prom_base.rsplit("/", 1)[0] + "/query_range" if prom_base else ""
+        if range_url:
+            start = timestamp - retention_days * 86400
+            backfilled = set(history.get("prometheusBackfilled") or [])
+            for metric_id, (query, unit) in PROMETHEUS_SERIES.items():
+                if metric_id in backfilled:
+                    continue
+                params = urllib.parse.urlencode({"query": query, "start": str(start),
+                                                 "end": str(timestamp), "step": "600"})
+                try:
+                    raw = subprocess.check_output(["kubectl", "get", "--raw", f"{range_url}?{params}"],
+                                                  text=True, timeout=45)
+                    rows = json.loads(raw).get("data", {}).get("result", [])
+                    backfilled.add(metric_id)
+                    kind = "state" if metric_id == "system.node_health" else "numeric"
+                    for row in rows:
+                        labels = row.get("metric") or {}
+                        name = prometheus_series_name(metric_id, labels)
+                        for raw_time, raw_value in row.get("values", []):
+                            try:
+                                value = float(raw_value)
+                                point_time = int(float(raw_time))
+                            except (TypeError, ValueError):
+                                continue
+                            if not math.isfinite(value):
+                                continue
+                            if metric_id == "system.node_health":
+                                value = 2.0 if value > 0 else 0.0
+                            append(metric_id, name, value, kind, unit, point_time)
+                except Exception:
+                    # Historical API support is optional; current collection remains authoritative.
+                    continue
+            history["prometheusBackfilled"] = sorted(backfilled)
+            history["prometheusBackfillComplete"] = len(backfilled) == len(PROMETHEUS_SERIES)
+
+    system = public_system(snapshot)
+    for layer in system.get("layers", []):
+        key = layer.get("key")
+        state = STATE_VALUE.get(layer.get("state"))
+        append(f"system.layer.{key}", layer.get("name") or key, state, "state", "상태")
+    watchers = current_payload.get("roleWatchers") or []
+    active = sum(1 for watcher in watchers if watcher.get("state") in ("ok", "operational"))
+    flow_state = 2 if watchers and active == len(watchers) else 1 if watchers else None
+    append("system.flow", "역할 인계", flow_state, "state", "상태")
+
+    for agent in current_payload.get("agents", []):
+        state = STATE_VALUE.get(agent.get("state"))
+        append("agents.status", agent.get("name") or "에이전트", state, "state", "상태")
+
+    current_metrics = ((snapshot.get("monitoring") or {}).get("timeseries") or {})
+    for metric_id, data in current_metrics.items():
+        for series in data.get("series") or []:
+            append(metric_id, series.get("name") or "전체", series.get("value"),
+                   data.get("kind", "numeric"), data.get("unit", ""))
+    # Known Prometheus series that temporarily vanish get a gap rather than a falsely continuous line.
+    for metric_id, (query, unit) in PROMETHEUS_SERIES.items():
+        entry = history["metrics"].get(metric_id)
+        if entry and not (current_metrics.get(metric_id) or {}).get("series"):
+            for series in entry.get("series", []):
+                if not series.get("points") or series["points"][-1][0] != timestamp:
+                    series.setdefault("points", []).append([timestamp, None])
+    for entry in history["metrics"].values():
+        for series in entry.get("series", []):
+            series["points"] = [point for point in series.get("points", []) if point[0] >= cutoff]
+    history["generatedAt"] = iso(now)
+    history["retentionDays"] = retention_days
+    history["sampleIntervalSeconds"] = 600
+    pending_path = path.with_name(path.name + ".new")
+    pending_path.write_text(json.dumps(history, ensure_ascii=False, separators=(",", ":")) + "\n", encoding="utf-8")
+    pending_path.replace(path)
+    return path
+
