+import contextlib
+import io
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+import collector
+import yaml
+
+
+def page(identifier, platform=None, **extra):
+    return {"object": "page", "id": identifier, "archived": False,
+            "in_trash": False, "last_edited_time": "2026-11-27T01:00:00Z",
+            "properties": {"플랫폼": {"type": "select", "select": platform},
+                           "제목": {"title": [{"plain_text": "private title"}]}}, **extra}
+
+
+def notion_page(rows, more=False, cursor=None):
+    return {"results": rows, "has_more": more, "next_cursor": cursor}
+
+
+def linear_page(rows, more=False, cursor=None):
+    return {"data": {"issues": {"nodes": rows, "pageInfo": {
+        "hasNextPage": more, "endCursor": cursor}}}}
+
+
+class TestWorkCounts(unittest.TestCase):
+    def setUp(self):
+        self.cfg = {"notion": {"social_media_content_data_source_id": "source-id"},
+                    "linear": {}, "work_counts": {"public_key": "work-counts.json"},
+                    "public_publish": {"bucket": "status-bucket", "key": "agents-live.json"}}
+        self.env = mock.patch.dict(collector.os.environ, {
+            "NOTION_SOCIAL_MEDIA_API_KEY": "notion-secret", "LINEAR_API_KEY": "linear-secret"}, clear=True)
+        self.env.start()
+        self.addCleanup(self.env.stop)
+
+    def responses(self, pages):
+        self.requests = []
+        def request(req, **kwargs):
+            self.requests.append(req)
+            result = next(pages)
+            if isinstance(result, Exception):
+                raise result
+            return contextlib.closing(io.BytesIO(json.dumps(result).encode()))
+        return mock.patch.object(collector.urllib.request, "urlopen", side_effect=request)
+
+    def test_notion_counts_all_active_pages_and_empty_select_from_same_traversal(self):
+        with self.responses(iter([
+            notion_page([page("1"), page("2", {"name": "Threads"}), page("archived", archived=True)], True, "cursor-1"),
+            notion_page([page("3"), page("trash", in_trash=True)], True, "cursor-2"),
+            notion_page([page("4", {"name": "Instagram"})]),
+        ])):
+            result = collector.collect_notion(self.cfg)
+        self.assertEqual(result.get("count"), 4)
+        self.assertEqual(result.get("withoutPlatform"), 2)
+        self.assertEqual(result["updatedAt"], "2026-11-27T01:00:00Z")
+        self.assertEqual([json.loads(r.data).get("start_cursor") for r in self.requests], [None, "cursor-1", "cursor-2"])
+        self.assertEqual(self.requests[0].full_url, "https://api.notion.com/v1/data_sources/source-id/query")
+
+    def test_failed_later_page_never_publishes_partial_notion_count(self):
+        with self.responses(iter([notion_page([page("1")], True, "next"), OSError("private error token=secret")])):
+            result = collector.collect_notion(self.cfg)
+        self.assertIsNone(result["count"])
+        self.assertNotIn("private error", json.dumps(result))
+
+    def test_invalid_notion_responses_are_unavailable_not_zero(self):
+        for response in [{}, {"results": [], "has_more": "false"},
+                         notion_page([page("1")], True),
+                         notion_page([page("1", properties={})])]:
+            with self.subTest(response=response), self.responses(iter([response])):
+                self.assertIsNone(collector.collect_notion(self.cfg)["count"])
+
+    def test_repeated_notion_cursor_is_failure(self):
+        with self.responses(iter([notion_page([page("1")], True, "same"), notion_page([page("2")], True, "same")])):
+            self.assertIsNone(collector.collect_notion(self.cfg)["count"])
+
+    def test_linear_paginates_workspace_backlog_without_archived_issues(self):
+        rows = [{"id": "a", "archivedAt": None, "state": {"type": "backlog"}},
+                {"id": "b", "archivedAt": None, "state": {"type": "backlog"}}]
+        with self.responses(iter([linear_page(rows[:1], True, "next"), linear_page(rows[1:])])):
+            result = collector.collect_linear(self.cfg)
+        self.assertEqual(result, {"backlog": 2, "status": "ok"})
+        bodies = [json.loads(r.data) for r in self.requests]
+        self.assertEqual([b["variables"]["after"] for b in bodies], [None, "next"])
+        self.assertIn('includeArchived: false', bodies[0]["query"])
+        self.assertIn('type: {eq: "backlog"}', bodies[0]["query"])
+        self.assertNotIn('team:', bodies[0]["query"])
+
+    def test_linear_zero_is_ok_and_graphql_or_pagination_failure_is_unavailable(self):
+        for responses, expected in [
+            ([linear_page([])], {"backlog": 0, "status": "ok"}),
+            ([{"errors": [{"message": "private error"}], **linear_page([])}], {"status": "unavailable"}),
+            ([linear_page([], True, "next"), OSError("secret")], {"status": "unavailable"}),
+            ([linear_page([], True, "next"), linear_page([], True, "next")], {"status": "unavailable"}),
+            ([{}], {"status": "unavailable"}),
+            ([linear_page([], True)], {"status": "unavailable"}),
+        ]:
+            with self.subTest(responses=responses), self.responses(iter(responses)):
+                self.assertEqual(collector.collect_linear(self.cfg), expected)
+
+    def test_service_failures_are_independent_and_feed_has_only_counts_status_time(self):
+        for notion, linear in [
+            ({"state": "warn", "count": None}, {"backlog": 0, "status": "ok"}),
+            ({"state": "ok", "count": 4, "withoutPlatform": 2, "private": "secret"}, {"status": "unavailable"}),
+        ]:
+            with mock.patch.object(collector, "collect_linear", return_value=linear):
+                result = collector.collect_work_counts(self.cfg, notion)
+            self.assertEqual(set(result), {"notion", "linear", "observedAt"})
+            self.assertEqual(result["linear"], linear)
+            self.assertEqual(result["notion"], {"total": 4, "withoutPlatform": 2, "status": "ok"}
+                             if notion["state"] == "ok" else {"status": "unavailable"})
+            self.assertRegex(result["observedAt"], r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$")
+            self.assertNotIn("secret", json.dumps(result))
+
+    def test_timer_path_publishes_work_counts_even_when_another_feed_fails(self):
+        snapshot = {"work_counts": {"notion": {"status": "unavailable"},
+                    "linear": {"backlog": 0, "status": "ok"}, "observedAt": "2026-11-28T00:00:00Z"}}
+        uploads = []
+        def run(args, **kwargs):
+            uploads.append((args, kwargs.get("input")))
+            return mock.Mock(returncode=0, stdout="", stderr="")
+        with mock.patch.object(collector, "publish_public", side_effect=RuntimeError("agents failed")), \
+             mock.patch.object(collector, "public_roster", return_value=[]), \
+             mock.patch.object(collector, "record_timeseries", return_value=None), \
+             mock.patch.object(collector.subprocess, "run", side_effect=run):
+            with self.assertRaisesRegex(RuntimeError, "agents"):
+                collector.publish_status_outputs(self.cfg, snapshot)
+        work = [(args, body) for args, body in uploads if "s3://status-bucket/work-counts.json" in args]
+        self.assertEqual(len(work), 1)
+        self.assertEqual(json.loads(work[0][1]), snapshot["work_counts"])
+
+    def test_snapshot_reuses_notion_observation_for_work_counts(self):
+        with self.responses(iter([notion_page([page("1"), page("2", {"name": "Threads"})]), linear_page([])])):
+            result = collector.build_snapshot(self.cfg, collect_crons_fn=lambda: [])
+        self.assertEqual(result["notion"]["count"], 2)
+        self.assertEqual(result["work_counts"]["notion"], {"total": 2, "withoutPlatform": 1, "status": "ok"})
+        self.assertEqual(result["work_counts"]["linear"], {"backlog": 0, "status": "ok"})
+        self.assertEqual(len(self.requests), 2)
+
+    def test_host_credential_file_works_without_shell_environment(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "linear.env"
+            path.write_text('LINEAR_API_KEY="file-secret"\n')
+            self.cfg["linear"]["env_file"] = str(path)
+            with mock.patch.dict(collector.os.environ, {}, clear=True), self.responses(iter([linear_page([])])):
+                self.assertEqual(collector.collect_linear(self.cfg), {"backlog": 0, "status": "ok"})
+            self.assertEqual(self.requests[0].get_header("Authorization"), "file-secret")
+
+    def test_config_removes_marketing_source_but_still_collects_kl(self):
+        cfg = yaml.safe_load((collector.BASE / "manifest.yaml").read_text())
+        with tempfile.TemporaryDirectory() as directory:
+            (Path(directory) / "summary.md").write_text("---\nstatus: summarized\n---\n")
+            (Path(directory) / "pending.md").write_text("---\nstatus: queued\n---\n")
+            for entry in cfg["backlogs"]:
+                entry["path"] = directory
+            result = collector.collect_backlogs(cfg)
+        self.assertEqual([row["name"] for row in result], ["kl-summarized"])
+        self.assertEqual(result[0]["count"], 1)
