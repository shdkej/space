+    try:
+        if isinstance(value, (int, float)):
+            if not math.isfinite(value):
+                return None
+            return dt.datetime.fromtimestamp(value / 1000 if abs(value) > 1e11 else value, dt.timezone.utc)
+        if isinstance(value, dt.datetime):
+            return value.replace(tzinfo=value.tzinfo or dt.timezone.utc).astimezone(dt.timezone.utc)
+        if isinstance(value, dt.date):
+            return dt.datetime.combine(value, dt.time(), dt.timezone.utc)
+        if value:
+            return timestamp(dt.datetime.fromisoformat(str(value).replace('Z', '+00:00')))
+    except (ValueError, TypeError, OverflowError, OSError):
+        pass
+    return None
+
+
+def iso(value):
+    t = timestamp(value)
+    return t.strftime('%Y-%m-%dT%H:%M:%SZ') if t else None
+
+
+def opaque(value):
+    return hashlib.sha256(str(value).encode()).hexdigest()[:24]
+
+
+def public_text(value, limit=240):
+    """Defense in depth for curated labels; private task text is never passed here."""
+    text = str(value or '')
+    # A credential-bearing label is suppressed wholesale, including quoted values.
+    if re.search(r'(?i)\b(?:bearer\s+|(?:token|secret|password|api[_-]?key)\s*[=:]|sk-|ghp_|github_pat_|xox[baprs]-|phx_)', text):
+        return '[비공개 항목]'
+    text = re.sub(r'(?i)\b(?:bearer\s+\S+|(?:token|secret|password|api[_-]?key)\s*[=:]\s*\S+)', '[비공개]', text)
+    text = re.sub(r'[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}', '[연락처]', text)
+    text = re.sub(r'(?:https?://|(?:[A-Za-z]:)?/|~/)[^\s<>]+', '[경로]', text)
+    text = re.sub(r'\b(?:sk-|ghp_|github_pat_|xox[baprs]-|phx_)[A-Za-z0-9_-]+', '[비공개]', text)
+    return re.sub(r'\s+', ' ', text).strip()[:limit]
+
+
+def public_url(value):
+    try:
+        u = urllib.parse.urlsplit(str(value or ''))
+        if u.scheme != 'https' or not u.netloc or u.username or u.password:
+            return None
+        return urllib.parse.urlunsplit((u.scheme, u.netloc, u.path, '', u.fragment if re.fullmatch(r'L\d+(?:-L\d+)?', u.fragment) else ''))
+    except ValueError:
+        return None
+
+
+def run_cmd(args):
+    p = subprocess.run(args, capture_output=True, text=True, timeout=25)
+    return p.returncode, p.stdout
+
+
+def read_rows(path, query):
+    # mode=ro prevents implicit file creation; query_only guards future query edits.
+    p = Path(path).expanduser().resolve()
+    with closing(sqlite3.connect(p.as_uri() + '?mode=ro', uri=True, timeout=2)) as conn:
+        conn.execute('PRAGMA query_only = ON')
+        conn.row_factory = sqlite3.Row
+        return [dict(row) for row in conn.execute(query)]
+
+
+def source_status(successes, failures, now):
+    return {'state': 'partial' if successes and failures else 'ok' if successes else 'unknown',
+            'observedAt': iso(now) if successes else None,
+            'failedSources': failures}
+
+
+def collect_sessions(settings, now):
+    """Merge run/node/window evidence by opaque session key; no transcript columns."""
+    candidates, parents = [], {}
+    successes = failures = 0
+    try:
+        rows = read_rows(settings.get('state_db', ''), '''
+            SELECT task_id,run_id,child_session_key,requester_session_key,agent_id,
+                   status,started_at,ended_at,last_event_at,created_at
+              FROM task_runs''')
+        for row in rows:
+            key = row['child_session_key'] or row['requester_session_key']
+            if not key:
+                continue
+            if row['child_session_key'] and row['requester_session_key'] != key:
+                parents[key] = row['requester_session_key']
+            candidates.append({'key': key, 'agent': row['agent_id'], 'status': row['status'],
+                               'start': row['started_at'], 'end': row['ended_at'],
+                               'activity': row['last_event_at'], 'run': row['run_id'] or row['task_id']})
+        successes += 1
+        links = read_rows(settings.get('state_db', ''),
+                         'SELECT child_session_key,requester_session_key FROM subagent_runs')
+        for row in links:
+            if row['child_session_key'] and row['requester_session_key'] != row['child_session_key']:
+                parents[row['child_session_key']] = row['requester_session_key']
+    except (OSError, sqlite3.Error, ValueError):
+        failures += 1
+    paths = sorted(Path(settings.get('agents_root', '/nonexistent')).expanduser().glob('*/agent/openclaw-agent.sqlite'))
+    if not paths:
+        failures += 1
+    for path in paths:
+        try:
+            rows = read_rows(path, '''
+                SELECT session_key,current_session_id,parent_session_key,
+                       json_extract(entry_json,'$.status') AS run_status,
+                       json_extract(entry_json,'$.startedAt') AS run_start,
+                       json_extract(entry_json,'$.endedAt') AS run_end,
+                       json_extract(entry_json,'$.lastActivityAt') AS run_activity,
+                       json_extract(entry_json,'$.activeWriterRunId') AS writer,
+                       json_extract(entry_json,'$.lastRunId') AS last_run,
+                       last_activity_at, session_started_at
+                  FROM session_nodes''')
+            windows = {row['session_id']: row for row in read_rows(path, '''
+                SELECT session_id,started_at,ended_at,parent_session_key FROM session_windows''')}
+            for row in rows:
+                window = windows.get(row['current_session_id']) or {}
+                key = row['session_key']
+                parent = row['parent_session_key'] or window.get('parent_session_key')
+                if parent and parent != key:
+                    parents[key] = parent
+                candidates.append({'key': key, 'agent': path.parts[-3], 'status': row['run_status'],
+                                   'start': row['run_start'] or window.get('started_at') or row['session_started_at'],
+                                   'end': row['run_end'] or window.get('ended_at'),
+                                   'activity': row['run_activity'] or row['last_activity_at'],
+                                   'run': row['last_run'] if row['run_status'] in TERMINAL else row['writer']})
+            successes += 1
+        except (OSError, sqlite3.Error, ValueError):
+            failures += 1
+    latest = {}
+    for row in candidates:
+        activity = timestamp(row['activity']) or timestamp(row['end'])
+        status = str(row['status'] or '').lower()
+        end = timestamp(row['end'])
+        # Historical null nodes and completed runs do not populate an office today.
+        if status not in ACTIVE and (not activity or (now - activity).total_seconds() > CADENCE):
+            continue
+        if status in TERMINAL and (not end or not 0 <= (now - end).total_seconds() <= CADENCE):
+            continue
+        row['evidence'] = activity
+        prev = latest.get(row['key'])
+        if prev is None or (activity or dt.datetime.min.replace(tzinfo=dt.timezone.utc)) > (prev['evidence'] or dt.datetime.min.replace(tzinfo=dt.timezone.utc)):
+            latest[row['key']] = row
+    sessions, events = [], {}
+    for key, row in latest.items():
+        status = str(row['status'] or '').lower()
+        activity, start, end = row['evidence'], timestamp(row['start']), timestamp(row['end'])
+        if status not in TERMINAL:
+            end = None  # Some nodes retain a prior run's end timestamp.
+        state = 'ended' if status in TERMINAL and end else ACTIVE.get(status, 'unknown')
+        if state != 'ended' and (not activity or not 0 <= (now - activity).total_seconds() <= STALE or (start and start > now)):
+            state = 'unknown'
+        agent = row['agent'] if row['agent'] in AGENTS else 'agent'
+        name, floor = AGENTS.get(agent, ('에이전트', 1))
+        sid = opaque(key)
+        sessions.append({'id': sid, 'agentId': agent, 'name': name, 'floor': floor,
+                         'state': state, 'startedAt': iso(start), 'observedAt': iso(activity),
+                         'parentId': opaque(parents[key]) if parents.get(key) else None,
+                         'taskLabel': f'{name} 실행', 'endedAt': iso(end)})
+        for kind, at in [('arrived', start), ('departed', end), ('reported', end if status in SUCCESS else None)]:
+            if at and status and 0 <= (now - at).total_seconds() <= CADENCE:
+                eid = opaque(f'{sid}:{row["run"] or iso(start)}:{kind}:{iso(at)}')
+                events[eid] = {'id': eid, 'sessionId': sid, 'type': kind, 'occurredAt': iso(at)}
+    sessions.sort(key=lambda row: row['id'])
+    return sessions, sorted(events.values(), key=lambda row: (row['occurredAt'], row['id'])), source_status(successes, failures, now)
+
+
+def collect_intents(settings, now, intents=None):
+    try:
+        if intents is None:
+            data = yaml.safe_load(Path(settings.get('intents_path', '')).expanduser().read_text()) or {}
+            lanes = data.get('lanes', {})
+        else:
+            lanes = intents.get('items', {})
+        tasks, questions, seen = [], [], set()
+        for lane in ('active', 'waiting', 'inbox', 'backlog'):
+            for row in lanes.get(lane) or []:
+                if not isinstance(row, dict) or not row.get('id') or row['id'] in seen:
+                    continue
+                seen.add(row['id'])
+                name, floor = AGENTS.get(row.get('target_agent') or row.get('agent_id') or 'genie', ('제품 실행', 1))
+                task_id = opaque('intent:' + str(row['id']))
+                # The approved board uses sanitized registry titles, never task bodies.
+                title = public_text(row.get('public_summary') or row.get('title'), 100) or f'{name} · {lane}'
+                tasks.append({'id': task_id, 'title': title, 'floor': floor, 'status': lane})
+                if row.get('waiting_on') == 'user' and lane in ('active', 'waiting'):
+                    questions.append({'id': task_id, 'sessionId': None, 'title': title,
+                                      'askedAt': iso(row.get('askedAt') or row.get('asked_at') or row.get('created_at')),
+                                      'sourceUrl': public_url(settings.get('intents_url')), 'state': 'waiting'})
+        questions.sort(key=lambda row: row['askedAt'] or '9999')
+        return tasks, questions, source_status(1, 0, now)
+    except (OSError, ValueError, yaml.YAMLError, AttributeError):
+        return [], [], source_status(0, 1, now)
+
+
+def collect_repositories(settings, now, run=run_cmd):
+    result, errors = [], 0
+    for cfg in settings.get('repositories', []):
+        row = {'name': public_text(cfg.get('name')), 'url': public_url(cfg.get('url')),
+               'branch': None, 'sha': None, 'dirtyCount': None, 'ahead': None, 'behind': None,
+               'observedAt': None, 'state': 'unknown', 'remoteCheckedAt': None}
+        try:
+            base = ['git', '-C', str(Path(cfg['path']).expanduser())]
+            def git(*args):
+                code, out = run(base + list(args))
+                if code: raise RuntimeError('git query failed')
+                return out.strip()
+            sha = git('rev-parse', 'HEAD')
+            if not re.fullmatch(r'[0-9a-f]{40,64}', sha): raise ValueError('invalid sha')
+            branch = git('rev-parse', '--abbrev-ref', 'HEAD')
+            # No filenames, authors, commit subjects, remotes or credentials leave the host.
+            dirty = git('status', '--porcelain=v1', '-z')
+            entries = dirty.split('\0'); count = i = 0
+            while i < len(entries):
+                if entries[i]:
+                    count += 1
+                    if entries[i][:1] in ('R', 'C') or entries[i][1:2] in ('R', 'C'): i += 1
+                i += 1
+            row.update(branch=public_text(branch, 80), sha=sha[:12], dirtyCount=count, observedAt=iso(now), state='ok')
+            code, out = run(base + ['rev-list', '--left-right', '--count', 'HEAD...@{upstream}'])
+            if code == 0 and re.fullmatch(r'\d+\s+\d+', out.strip()):
+                row['ahead'], row['behind'] = map(int, out.split())
+            row['comparison'] = 'local tracking ref'
+        except (OSError, ValueError, KeyError, RuntimeError, subprocess.SubprocessError):
+            errors += 1
+        result.append(row)
+    return result, source_status(len(result) - errors, errors, now)
+
+
+def query_metric_rows(settings, run=run_cmd):
+    binary = settings.get('kubectl') or shutil.which('kubectl') or '/usr/local/bin/kubectl'
+    args = [binary]
+    if settings.get('kubeconfig'):
+        args += ['--kubeconfig', str(Path(settings['kubeconfig']).expanduser())]
+    base = settings.get('prometheus_service')
+    if not base:
+        raise ValueError('metrics source not configured')
+    # A range vector returns sample times; ordinary instant vectors use query time.
+    names = '|'.join([m[2] for m in METRICS if m[2]] + ['product_app_connected', 'product_retained_users', 'product_churned_users'])
+    query = '{__name__=~"' + names + '"}[15m]'
+    code, out = run(args + ['get', '--raw', base + '?' + urllib.parse.urlencode({'query': query})])
+    if code: raise RuntimeError('metrics query failed')
+    payload = json.loads(out)
+    if payload.get('status') != 'success': raise ValueError('metrics response failed')
+    return payload.get('data', {}).get('result', [])
+
+
+def collect_projects(settings, now, metric_rows=None, run=run_cmd):
+    try:
+        rows = metric_rows if metric_rows is not None else query_metric_rows(settings, run)
+        source = source_status(1, 0, now)
+    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):
+        rows, source = [], source_status(0, 1, now)
+    source.update(upstreamFreshness='unknown', detail='Prometheus 표본 시각 · PostHog 마지막 성공 수집 시각은 exporter 미제공')
+    projects = {str(row['id']): public_text(row.get('name') or row['id']) for row in settings.get('projects', [])}
+    samples = {}
+    for row in rows:
+        labels = row.get('metric') or {}
+        service = labels.get('service')
+        if not service or not re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}', service):
+            continue
+        projects.setdefault(service, public_text(service))
+        values = row.get('values') or ([row['value']] if row.get('value') else [])
+        for raw_time, raw_value in values:
+            try:
+                value, at = float(raw_value), timestamp(float(raw_time))
+                if not math.isfinite(value) or not at: continue
+            except (ValueError, TypeError):
+                continue
+            key = (service, labels.get('__name__'))
+            if key not in samples or at > samples[key][1]:
+                samples[key] = (value, at, {k: public_text(labels[k], 64) for k in ('service', 'period') if k in labels})
+    result = []
+    for pid, name in projects.items():
+        metrics = []
+        connected = samples.get((pid, 'product_app_connected'))
+        for stage, label, metric_name, unit, window in METRICS:
+            item = samples.get((pid, metric_name)) if metric_name else None
+            state = 'unavailable' if source['state'] != 'ok' else 'unconnected'
+            if item:
+                state = 'ok' if 0 <= (now - item[1]).total_seconds() <= STALE else 'stale'
+            if connected and connected[0] == 0:
+                item, state = None, 'unconnected'
+            # Exporter emits 0% for an empty retention denominator. That is no data.
+            if stage == 'retention' and item:
+                retained, churned = samples.get((pid, 'product_retained_users')), samples.get((pid, 'product_churned_users'))
+                if not retained or not churned or retained[0] + churned[0] <= 0:
+                    item, state = None, 'unavailable'
+            metrics.append({'stage': stage, 'label': label, 'value': item[0] if item else None,
+                            'unit': unit, 'window': window, 'state': state,
+                            'observedAt': iso(item[1]) if item else None,
+                            'sourceMetric': metric_name, 'sourceLabels': item[2] if item else {'service': pid},
+                            'upstreamFreshness': 'unknown'})
+        observations = [m['observedAt'] for m in metrics if m['observedAt']]
+        states = {m['state'] for m in metrics}
+        result.append({'id': pid, 'name': name, 'observedAt': max(observations) if observations else None,
+                       'state': 'partial' if 'ok' in states else 'stale' if 'stale' in states else 'unavailable' if source['state'] != 'ok' else 'unconnected', 'metrics': metrics})
+    return result, source
+
+
+def collect_strategy(settings, now):
+    result = {'strategy': [], 'values': [], 'hypotheses': [], 'observedAt': None}
+    successes = failures = 0
+    for section in ('strategy', 'values', 'hypotheses'):
+        for item in (settings.get('strategy') or {}).get(section, []):
+            try:
+                path = Path(item['source_path']).expanduser()
+                # Only the configured public summary is exported; never the document.
+                if not item.get('evidence') or item['evidence'] not in path.read_text():
+                    raise ValueError('document evidence missing')
+                at = iso(path.stat().st_mtime)
+                entry = {'id': opaque(item['id']), 'title': public_text(item['title']),
+                         'detail': public_text(item.get('detail'), 500), 'sourceUrl': public_url(item.get('sourceUrl')),
+                         'sourceLabel': public_text(item.get('source_label') or path.name), 'observedAt': at}
+                if section == 'hypotheses':
+                    entry.update(state='hypothesis', nextAction=public_text(item.get('next_action')))
+                result[section].append(entry)
+                result['observedAt'] = max(result['observedAt'] or '', at)
+                successes += 1
+            except (OSError, ValueError, KeyError):
+                failures += 1
+    return result, source_status(successes, failures, now)
+
+
+def collect_day(settings, now):
+    config = settings.get('day') or {}
+    result = {'phase': 'unknown', 'closedAt': None, 'timeZone': config.get('time_zone')}
+    try:
+        local = now.astimezone(ZoneInfo(config['time_zone']))
+        close, opened = int(config['close_hour']), int(config['open_hour'])
+        if not 0 <= opened < close <= 23: return result
+        if opened <= local.hour < close:
+            return dict(result, phase='open')
+        at = local.replace(hour=close, minute=0, second=0, microsecond=0)
+        if local.hour < opened: at -= dt.timedelta(days=1)
+        return dict(result, phase='closing' if (local - at).total_seconds() < CADENCE else 'closed', closedAt=iso(at))
+    except (KeyError, ValueError):
+        return result
+
+
+def collect_office(cfg, snapshot=None, now=None, run=run_cmd):
+    now = now or dt.datetime.now(dt.timezone.utc)
+    settings = dict(cfg.get('office') or {})
+    settings.setdefault('prometheus_service', (cfg.get('monitoring') or {}).get('prometheus_service'))
+    result = {'schemaVersion': 1, 'observedAt': iso(now), 'cadenceSeconds': CADENCE,
+              'staleAfterSeconds': STALE, 'sources': {}}
+    result['sessions'], result['events'], result['sources']['sessions'] = collect_sessions(settings, now)
+    intents = (snapshot or {}).get('intents')
+    if snapshot is not None and 'intents' in snapshot and intents is None:
+        result['tasks'], result['questions'], result['sources']['tasks'] = [], [], source_status(0, 1, now)
+    else:
+        result['tasks'], result['questions'], result['sources']['tasks'] = collect_intents(settings, now, intents)
+    result['repositories'], result['sources']['repositories'] = collect_repositories(settings, now, run)
+    result['projects'], result['sources']['metrics'] = collect_projects(settings, now, run=run)
+    result['strategy'], result['sources']['strategy'] = collect_strategy(settings, now)
+    result['day'] = collect_day(settings, now)
+    by_id = {row['id']: row for row in result['sessions']}
+    result['activity'] = [{'id': e['id'], 'label': {'arrived': '실행 시작', 'departed': '실행 종료', 'reported': '결과 보고'}[e['type']],
+                           'occurredAt': e['occurredAt'], 'floor': by_id[e['sessionId']]['floor']} for e in result['events']]
+    return result
+
+
+def write_snapshot(path, payload):
+    path = Path(path).expanduser()
+    path.parent.mkdir(parents=True, exist_ok=True)
+    pending = path.with_name(path.name + '.new')
+    pending.write_text(json.dumps(payload, ensure_ascii=False, separators=(',', ':'), allow_nan=False) + '\n')
+    pending.replace(path)
+    return path
+
+
+def publish_office(cfg, payload, run=run_cmd):
+    settings, pub = cfg.get('office') or {}, cfg.get('public_publish') or {}
+    if not settings.get('local_path'): return None
+    path = Path(settings['local_path']).expanduser()
+    if payload is not None:
+        write_snapshot(path, payload)
+    # On whole-collection failure the old file remains byte-for-byte unchanged.
+    if not path.is_file() or not pub.get('bucket') or not settings.get('public_key'): return None
+    dest = f"s3://{pub['bucket']}/{settings['public_key']}"
+    aws = shutil.which('aws') or str(Path.home() / '.local/bin/aws')
+    code, _ = run([aws, 's3', 'cp', str(path), dest, '--cache-control', 'no-store', '--content-type', 'application/json'])
+    if code: raise RuntimeError('office publish failed')
+    return dest
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--config', default=str(Path(__file__).with_name('manifest.yaml')))
+    parser.add_argument('--output', required=True, help='Local public JSON snapshot path')
+    parser.add_argument('--publish', action='store_true', help='Also publish to the configured existing status bucket')
+    args = parser.parse_args(argv)
+    cfg = yaml.safe_load(Path(args.config).read_text())
+    payload = collect_office(cfg)
+    write_snapshot(args.output, payload)
+    if args.publish:
+        cfg.setdefault('office', {})['local_path'] = args.output
+        publish_office(cfg, payload)
+    print(json.dumps({'schemaVersion': payload['schemaVersion'], 'observedAt': payload['observedAt'],
+                      'sessions': len(payload['sessions']), 'questions': len(payload['questions']),
+                      'sources': {key: value['state'] for key, value in payload['sources'].items()}}))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
