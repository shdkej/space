@@ -0,0 +1,50 @@
+import datetime as dt
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+import collector
+
+
+class TestMonitoringRemoval(unittest.TestCase):
+    def test_evidence_queries_only_nodes_and_repo_timestamps(self):
+        calls = []
+        def request(args, **kwargs):
+            calls.append(args)
+            if args[0] == 'kubectl':
+                return json.dumps({'data': {'result': [{'metric': {'node': 'test-node'}}]}})
+            return json.dumps([{'sha': 'abc12345', 'commit': {'committer': {'date': '2026-11-27T00:00:00Z'}}}])
+        with mock.patch.dict(collector.os.environ, {}, clear=True), mock.patch.object(collector.shutil, 'which', return_value='gh'), mock.patch.object(collector.subprocess, 'check_output', side_effect=request):
+            out = collector.collect_evidence({'evidence': {'prometheus_service': '/test/query', 'github_repositories': ['owner/repo']}})
+        self.assertEqual(len(calls), 2)
+        self.assertIn('kube_node_info', calls[0][-1])
+        self.assertEqual(out['github'][0]['sha'], 'abc1234')
+        self.assertEqual(out['prometheus']['nodes'][0]['name'], 'test-node')
+        self.assertEqual(set(out), {'updatedAt', 'github', 'prometheus'})
+
+    def test_public_feed_omits_retired_monitoring_even_in_old_snapshot(self):
+        snapshot = {'monitoring': {'content': {'private': 'should-not-publish'}}, 'evidence': {'github': []}}
+        out = collector.public_payload(snapshot, [])
+        self.assertNotIn('monitoring', out)
+        self.assertEqual(out['evidence'], {'github': []})
+        self.assertNotIn('should-not-publish', json.dumps(out))
+
+    def test_history_retains_state_samples_without_prometheus_backfill(self):
+        now = dt.datetime(2026, 11, 27, tzinfo=dt.timezone.utc)
+        stamp = int(now.timestamp()) - 600
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'history.json'
+            state = {'kind':'state', 'series':[{'name':'Agent', 'points':[[stamp,2]]}]}
+            path.write_text(json.dumps({'prometheusBackfillComplete': True, 'prometheusBackfilled':['system.cpu'], 'metrics':{'system.cpu':state, 'agents.status':state, 'customer.sessions':state}}))
+            cfg = {'timeseries': {'local_path':str(path)}}
+            with mock.patch.object(collector.subprocess,'check_output',side_effect=AssertionError('no historical query')):
+                collector.record_timeseries(cfg, {}, {'agents': [{'name':'Agent','state':'ok'}]}, now=now)
+            result = json.loads(path.read_text())
+        self.assertNotIn('system.cpu', result['metrics'])
+        self.assertNotIn('customer.sessions', result['metrics'])
+        self.assertNotIn('prometheusBackfillComplete', result)
+        self.assertEqual(result['metrics']['agents.status']['series'][0]['points'][0], [stamp,2])
+        self.assertEqual(len(result['metrics']['agents.status']['series'][0]['points']), 2)
+        self.assertIn('system.layer.l1',result['metrics'])
