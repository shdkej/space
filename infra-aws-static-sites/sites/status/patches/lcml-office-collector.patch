+def publish_timeseries(cfg, history_path, run=None):
+    settings = cfg.get("timeseries") or {}
+    pub = cfg.get("public_publish") or {}
+    key = settings.get("public_key")
+    if not history_path or not pub.get("bucket") or not key:
+        return None
+    dest = f"s3://{pub['bucket']}/{key}"
+    args = [_aws_bin(), "s3", "cp", str(history_path), dest,
+            "--cache-control", "max-age=60", "--content-type", "application/json"]
+    code, out = run(args) if run is not None else run_cmd(args)
+    if code != 0:
+        raise RuntimeError(f"timeseries publish failed: {out[-200:]}")
+    return dest
+
+
+def publish_status_outputs(cfg, snapshot, run=None):
+    roster = public_roster(snapshot)
+    payload = public_payload(snapshot, roster)
+    history_path = record_timeseries(cfg, snapshot, payload)
+    feed_dest = publish_public(cfg, snapshot, run=run, roster=roster)
+    history_dest = publish_timeseries(cfg, history_path, run=run)
+    return feed_dest, history_dest
+
