+import datetime as dt
+import json
+import sqlite3
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+import collector
+import office
+
+NOW = dt.datetime(2026, 11, 11, 12, 0, tzinfo=dt.timezone.utc)
+
+
+def ms(minutes=0):
+    return int((NOW + dt.timedelta(minutes=minutes)).timestamp() * 1000)
+
+
+class OfficeTest(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.settings = {'state_db': str(self.root / 'state.sqlite'),
+                         'agents_root': str(self.root / 'agents'),
+                         'intents_path': str(self.root / 'INTENTS.yaml'),
+                         'projects': [{'id': 'virtue', 'name': 'Virtue'},
+                                      {'id': 'policycock', 'name': '정책콕'}]}
+
+    def database(self, rows=(), tasks=(), windows=()):
+        p = self.root / 'agents' / 'genie' / 'agent' / 'openclaw-agent.sqlite'
+        p.parent.mkdir(parents=True)
+        c = sqlite3.connect(p)
+        c.execute('create table session_nodes(session_key text,current_session_id text,entry_json text,parent_session_key text,updated_at integer,last_activity_at integer,session_started_at integer,status text)')
+        c.execute('create table session_windows(session_id text,session_key text,started_at integer,ended_at integer,status text,parent_session_key text)')
+        for key, entry in rows:
+            c.execute('insert into session_nodes values(?,?,?,?,?,?,?,?)',
